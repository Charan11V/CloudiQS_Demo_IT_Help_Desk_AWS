    {
      "issue_code": "ID-01",
      "category": "identity",
      "subcategory": "Password and login",
      "label": "Account locked",
      "clarifying_question": "Do you see an account locked message?",
      "evidence_to_fetch": "account.status=locked, lock_reason, sign-in events",
      "action_code": "unlock_own_account",
      "approval_type": "conditional",
      "verify": "account.status=active and new login simulation succeeds",
      "nominal_outcome": "resolved",
      "tier": "P0"
    },
    {
      "issue_code": "ID-02",
      "category": "identity",
      "subcategory": "Password and login",
      "label": "Forgot password",
      "clarifying_question": "Do you need to reset your own password?",
      "evidence_to_fetch": "verified user identity, reset policy, account state",
      "action_code": "issue_self_reset_challenge",
      "approval_type": "self_verification",
      "verify": "reset challenge completed and credentials_version incremented",
      "nominal_outcome": "resolved_after_user_action",
      "tier": "P0"
    },
    {
      "issue_code": "ID-03",
      "category": "identity",
      "subcategory": "Password and login",
      "label": "Password expired",
