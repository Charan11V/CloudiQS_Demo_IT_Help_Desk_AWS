# HELIO local demo — copy to .env
# Providers: simulator | bedrock | ollama | openai_compatible
MODEL_PROVIDER=openai_compatible

# --- GPT-OSS-20B (agent freeform + bakery Others triage) ---
# Get a key: https://console.groq.com/keys
# Used by agent-api (MODEL_PROVIDER=openai_compatible) and bakery-api Others section.
OPENAI_API_KEY=
# GROQ_API_KEY=   # alternate name; OPENAI_API_KEY is preferred
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL_ID=openai/gpt-oss-20b

# --- Bedrock (blocked until account authorization) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# AWS_BEARER_TOKEN_BEDROCK=
# Do NOT put long-lived AWS access keys here. Prefer `aws login` / instance role.

DEMO_NOW=2026-10-31T10:00:00Z
APP_SESSION_SIGNING_KEY=dev-only-insecure-key-change-me
ENABLE_FAULT_INJECTION=1
LOG_LEVEL=INFO
# AWS public demo outer gate (set via SSM SecureString in cloud)
# DEMO_GATE_ENABLED=0
# DEMO_ACCESS_SECRET=

# --- Amazon Bedrock AgentCore Runtime (optional; local Docker works with ENABLED=0) ---
# AGENTCORE_ENABLED=0
# AGENTCORE_RUNTIME_ARN=
# AGENTCORE_REGION=us-east-1
# TOOL_BRIDGE_PUBLIC_URL=http://127.0.0.1:8001/internal/agentcore/tools
# TOOL_BRIDGE_SECRET=local-dev-bridge-secret

