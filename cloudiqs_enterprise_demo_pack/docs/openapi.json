  "components": {
    "schemas": {
      "Decision": {
        "properties": {
          "decision": {
            "type": "string",
            "pattern": "^(approved|rejected)$",
            "title": "Decision"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "reason"
        ],
        "title": "Decision"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewApproval": {
        "properties": {
          "action_type": {
            "type": "string",
            "title": "Action Type"
          },
          "target_user_id": {
            "type": "string",
            "title": "Target User Id"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "rationale": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 5,
            "title": "Rationale"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action_type",
          "target_user_id",
          "rationale"
        ],
        "title": "NewApproval"
      },
      "NewTicket": {
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 250,
            "minLength": 5,
            "title": "Summary"
          },
          "description": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 5,
            "title": "Description"
          },
          "category": {
            "type": "string",
            "pattern": "^(identity|vpn|device|email|software|network|business_app|security|onboarding|offboarding|procurement|cloud_access)$",
            "title": "Category"
          },
          "requester_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requester Id"
          },
          "priority": {
            "type": "string",
            "title": "Priority",
            "default": "P3"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary",
          "description",
          "category"
        ],
        "title": "NewTicket"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
